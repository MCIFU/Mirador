<?xml version="1.0" encoding="utf-8"?>
<!-- USBX no guarda nada que merezca copia en la nube: los permisos de la memoria USB no se
     pueden restaurar en otro dispositivo y las miniaturas son caché. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
