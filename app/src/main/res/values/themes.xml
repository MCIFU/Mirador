<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Usbx" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/usbx_background</item>
    </style>

    <style name="Theme.Usbx.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/usbx_background</item>
